from core.constitution import DynamicConstitution
from core.semantic_buffer import SemanticBuffer
from core.memory.manager import MemoryManager

class GestaltEngine:
    """用於多模態意圖對齊和上下文融合的高級格式塔引擎"""
    def __init__(self, capacity: int = 5):
        self.buffer = SemanticBuffer(capacity=capacity)
        self.constitution = DynamicConstitution()
        # 初始化長期記憶管理器
        self.memory_manager = MemoryManager()

    def process_intent(self, user_input: str) -> dict:
        # 1. 檢索相關的長期記憶作為背景脈絡
        historical_context = self.memory_manager.retrieve_relevant_context(limit=3)

        # 2. 推進語意緩衝，捕捉上下文
        self.buffer.push(user_input)
        current_context = self.buffer.get_context()

        # 3. 執行動態憲法合約校驗
        validation_result = self.constitution.validate(current_context)
        if not validation_result["is_valid"]:
            response = {
                "狀態": "已拒絕",
                "原因": validation_result["reason"],
                "歷史脈絡": historical_context
            }
        else:
            response = {
                "狀態": "已核准",
                "上下文": current_context,
                "歷史脈絡": historical_context,
                "輸出": f"已成功處理主公意圖：{user_input}"
            }

        # 4. 將當前互動寫入長期記憶庫
        self.memory_manager.ingest_context(
            user_intent=user_input, 
            response_text=str(response)
        )

        return response
